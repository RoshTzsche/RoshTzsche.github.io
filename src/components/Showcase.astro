---
// One big project showcase: kicker, award, huge title, media, numbers,
// problem / what we built / result, links. Monochrome; colour arrives
// when the showcase scrolls into view.
import type { Showcase } from '../data/showcase';
import type { Lang } from '../i18n/ui';
interface Props { s: Showcase; lang: Lang; n: number; total: number }
const { s, lang, n, total } = Astro.props;
const L = {
  es: { problem: 'El problema', built: 'Lo que construimos', result: 'Resultado', code: 'Código', demo: 'demo' },
  en: { problem: 'The problem', built: 'What we built', result: 'Result', code: 'Code', demo: 'demo' },
}[lang];
const pad = (x: number) => String(x).padStart(2, '0');
---
<article id={`show-${s.repo}`} class:list={['show', { tall: s.hero.tall }]} data-show>
  <header class="show-head">
    <p class="kicker mono"><span class="num">{pad(n)} / {pad(total)}</span> · {s.kicker[lang]}</p>
    <p class="award mono"><span class="star" aria-hidden="true">★</span> {s.award[lang]}</p>
    <h3><a href={s.href}>{s.title}</a></h3>
    <p class="hook">{s.hook[lang]}</p>
  </header>

  <div class="media">
    <figure class="hero">
      {s.hero.video ? (
        <>
          <video src={s.hero.video} poster={s.hero.src} muted loop playsinline preload="none" data-autoplay aria-label={s.hero.alt[lang]}></video>
          <span class="live mono">{L.demo}</span>
        </>
      ) : (
        <img src={s.hero.src} alt={s.hero.alt[lang]} loading="lazy" decoding="async" />
      )}
    </figure>
    <div class="gallery">
      {s.gallery.map((g) => (
        <figure><img src={g.src} alt={g.alt[lang]} loading="lazy" decoding="async" /><figcaption class="mono">{g.alt[lang]}</figcaption></figure>
      ))}
    </div>
  </div>

  <dl class="stats">
    {s.stats.map((st) => (
      <div><dt>{st.value}</dt><dd class="mono">{st.label[lang]}</dd></div>
    ))}
  </dl>

  <div class="story">
    <section><h4 class="mono">{L.problem}</h4><p>{s.problem[lang]}</p></section>
    <section><h4 class="mono">{L.built}</h4><p>{s.built[lang]}</p></section>
    <section><h4 class="mono">{L.result}</h4><p class="result">{s.result[lang]}</p></section>
  </div>

  <footer class="show-foot">
    <div class="actions">
      {s.links.map((l) => <a class="btn" href={l.href}>{l.label[lang]} ↗</a>)}
      <a class="btn" href={s.href}>{L.code} ↗</a>
    </div>
    <ul class="tags mono">{s.stack.map((t) => <li>{t}</li>)}</ul>
  </footer>
</article>

<style>
  .show {
    padding: clamp(48px, 7vw, 104px) 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: clamp(28px, 3.5vw, 48px);
    scroll-margin-top: 96px;
  }
  .show:first-child { border-top: 0; padding-top: clamp(16px, 2vw, 28px); }

  .show-head { display: grid; gap: 12px; }
  .kicker { margin: 0; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .num { color: var(--fg); }
  .award { margin: 0; font-size: clamp(14px, 0.4vw + 11px, 17px); letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg); }
  .star { color: var(--accent); }
  h3 {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: clamp(52px, 8.5vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  :global(:root[data-mode='paper']) h3 { font-weight: 500; letter-spacing: -0.02em; }
  h3 a { color: var(--fg); text-decoration: none; transition: color 0.2s ease; }
  h3 a:hover { color: var(--accent); }
  .hook { margin: 0; font-size: clamp(20px, 1.2vw + 12px, 32px); line-height: 1.3; color: var(--fg-2); max-width: 32ch; }
  :global(:root[data-mode='paper']) .hook { font-style: italic; }

  /* media: wide hero + gallery row; tall hero (video) sits beside a gallery column */
  .media { display: grid; gap: 12px; }
  .media figure { margin: 0; position: relative; overflow: hidden; border-radius: var(--radius); background: var(--surface-2); }
  .media img, .media video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero { aspect-ratio: 16 / 9; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .gallery figure { aspect-ratio: 16 / 10; }
  .gallery figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 10px 8px;
    font-size: 11px; line-height: 1.35; color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    opacity: 0; transition: opacity 0.25s ease;
  }
  .gallery figure:hover figcaption { opacity: 1; }
  .tall .media { grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr); align-items: stretch; }
  .tall .hero { aspect-ratio: 464 / 640; }
  .tall .gallery { grid-template-columns: 1fr; grid-template-rows: repeat(3, minmax(0, 1fr)); }
  .tall .gallery figure { aspect-ratio: auto; }

  /* black and white until the showcase is in view */
  .media img, .media video { filter: grayscale(1) contrast(1.05); transition: filter 1.2s ease; }
  .show.in-view .media img, .show.in-view .media video { filter: none; }

  .live { position: absolute; left: 12px; bottom: 10px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: rgba(0, 0, 0, 0.55); padding: 3px 10px; border-radius: 999px; }
  .live::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: #e5484d; vertical-align: 1px; animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }

  .stats { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .stats > div { padding: clamp(18px, 2vw, 28px) clamp(12px, 2vw, 28px); border-left: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  .stats > div:first-child { border-left: 0; padding-left: 0; }
  .stats dt { font-family: var(--font-display); font-size: clamp(32px, 3.6vw, 60px); line-height: 1; font-weight: 700; letter-spacing: -0.02em; color: var(--fg); }
  :global(:root[data-mode='paper']) .stats dt { font-weight: 500; }
  .stats dd { margin: 0; font-size: 12px; line-height: 1.45; letter-spacing: 0.02em; color: var(--muted); max-width: 26ch; }

  .story { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 48px); }
  .story h4 { margin: 0 0 12px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .story p { margin: 0; font-size: clamp(15px, 0.3vw + 12px, 18px); line-height: 1.65; color: var(--fg-2); }
  .story .result { color: var(--fg); }

  .show-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .tags li { padding: 3px 10px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 12px; color: var(--muted); }

  @media (max-width: 860px) {
    .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .tall .media { grid-template-columns: 1fr; }
    .tall .hero { max-height: 80vh; aspect-ratio: 464 / 640; }
    .tall .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: none; }
    .tall .gallery figure { aspect-ratio: 16 / 10; }
    .stats { grid-template-columns: 1fr; }
    .stats > div { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .stats > div:first-child { border-top: 0; }
    .story { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .media img, .media video { transition: none; }
    .live::before { animation: none; }
  }
</style>

<script>
  // Colour in, and play the demo, while a showcase is on screen.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shows = document.querySelectorAll<HTMLElement>('[data-show]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        el.classList.toggle('in-view', e.isIntersecting);
        const v = el.querySelector<HTMLVideoElement>('video[data-autoplay]');
        if (v && !reduce) e.isIntersecting ? v.play().catch(() => {}) : v.pause();
      }
    }, { threshold: 0.25 });
    shows.forEach((s) => io.observe(s));
  } else {
    shows.forEach((s) => s.classList.add('in-view'));
  }
</script>
