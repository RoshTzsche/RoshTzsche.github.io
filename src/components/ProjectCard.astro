---
import fs from 'node:fs';
import { repoUrl, type Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
interface Props { p: Project; lang: Lang; big?: boolean }
const { p, lang, big = false } = Astro.props;

// Picks up public/projects/<repo>.(webp|jpg|jpeg|png|gif) automatically
const image = ['webp', 'jpg', 'jpeg', 'png', 'gif']
  .map((ext) => `/projects/${p.repo}.${ext}`)
  .find((src) => fs.existsSync(`public${src}`));
const alt = p.imageAlt?.[lang] ?? p.title[lang];
---
<article id={`p-${p.repo}`} class:list={['card', 'project', { awarded: !!p.award, big, 'has-image': !!image }]}>
  {image && (
    <a class="cover" href={repoUrl(p.repo)} tabindex="-1" aria-hidden="true">
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    </a>
  )}
  {p.award && (
    <p class="award mono">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"></path><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"></path></svg>
      {p.award[lang].replace(/^★\s*/, '')}
    </p>
  )}
  <p class="meta mono">{p.repo} · {p.stack}</p>
  <h3><a href={repoUrl(p.repo)}>{p.title[lang]} <span aria-hidden="true" class="arrow">↗</span></a></h3>
  <p class="body">{p.body[lang]}</p>
  {(p.foot || p.links) && (
    <div class="foot mono">
      {p.foot && <span>{p.foot[lang]}</span>}
      {p.links?.map((l) => <a href={l.href}>{l.label[lang]} ↗</a>)}
    </div>
  )}
</article>

<style>
  .project { position: relative; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; scroll-margin-top: 96px; }
  .project:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: var(--shadow); }
  .project:target { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
  .cover { display: block; margin: -24px -24px 4px; overflow: hidden; border-radius: var(--radius) var(--radius) 0 0; aspect-ratio: 16 / 9; background: var(--surface-2); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .project:hover .cover img { transform: scale(1.04); }
  .awarded { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, var(--surface)) 0%, var(--surface) 55%); }
  .award { margin: 0; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-size: 12px; font-weight: 700; line-height: 1.3; }
  .big h3 { font-size: 24px; }
  h3 { margin: 0; font-size: 20px; font-weight: 600; font-family: var(--font-body); line-height: 1.3; }
  :global(:root[data-mode='paper']) .project h3 { font-size: 24px; font-weight: 500; font-family: var(--font-display); }
  h3 a::after { content: ''; position: absolute; inset: 0; } /* whole card clickable */
  .arrow { color: var(--muted); }
  .meta { margin: 0; font-size: 12px; color: var(--muted); }
  .body { margin: 0; font-size: 15px; line-height: 1.6; color: var(--fg-2); }
  :global(:root[data-mode='paper']) .body { font-size: 17px; }
  .foot { margin-top: auto; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: var(--muted); position: relative; z-index: 1; }
  .foot a { color: var(--fg-2); text-decoration: underline; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .project, .cover img { transition: none; } .project:hover { transform: none; } }
</style>
