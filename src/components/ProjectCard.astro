---
import { repoUrl, type Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
interface Props { p: Project; lang: Lang }
const { p, lang } = Astro.props;
---
<article class="card project">
  <p class="meta mono">{p.repo} · {p.stack}</p>
  <h3><a href={repoUrl(p.repo)}>{p.title[lang]} <span aria-hidden="true" class="muted">↗</span></a></h3>
  <p class="body">{p.body[lang]}</p>
  <div class="foot mono">
    {p.award && <span class="award">{p.award[lang]}</span>}
    {p.foot && <span>{p.foot[lang]}</span>}
    {p.links?.map((l) => <a href={l.href}>{l.label[lang]} ↗</a>)}
  </div>
</article>

<style>
  .project h3 { margin: 0; font-size: 20px; font-weight: 600; font-family: var(--font-body); line-height: 1.3; }
  :global(:root[data-mode='paper']) .project h3 { font-size: 24px; font-weight: 500; }
  .meta { margin: 0; font-size: 12px; color: var(--muted); }
  .body { margin: 0; font-size: 15px; line-height: 1.6; color: var(--fg-2); }
  :global(:root[data-mode='paper']) .body { font-size: 17px; }
  .foot { margin-top: auto; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: var(--muted); }
  .foot a { color: var(--fg-2); text-decoration: underline; text-underline-offset: 3px; }
  .award { color: var(--accent); }
</style>
