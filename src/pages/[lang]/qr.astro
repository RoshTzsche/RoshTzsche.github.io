---
// QR generator: a faint Takens attractor behind the code, terminal / paper styles.
import Base from '../../layouts/Base.astro';
import { getStaticLangPaths, otherLang, type Lang } from '../../i18n/ui';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const site = Astro.site!.href.replace(/\/$/, '');
const T = {
  es: {
    title: 'Generador de QR', kicker: 'HERRAMIENTA', h1: 'QR con atractor',
    sub: 'Un código QR con un atractor de Takens tenue de fondo. Usa corrección de errores alta (H) para que se lea sin problemas.',
    text: 'Texto o enlace', presets: 'Atajos', style: 'Estilo', terminal: 'terminal', paper: 'papel',
    download: 'Descargar PNG', downloadSvg: 'Descargar SVG', tip: 'Prueba siempre el código con la cámara de tu teléfono antes de imprimirlo. El estilo papel (oscuro sobre claro) es el más compatible con lectores antiguos.',
    p: { home: 'Mi web', lab: 'Laboratorio', chess: 'Retarme (Lichess)', cv: 'CV', github: 'GitHub' },
  },
  en: {
    title: 'QR generator', kicker: 'TOOL', h1: 'Attractor QR',
    sub: 'A QR code with a faint Takens attractor in the background. It uses high error correction (H) so it scans reliably.',
    text: 'Text or link', presets: 'Shortcuts', style: 'Style', terminal: 'terminal', paper: 'paper',
    download: 'Download PNG', downloadSvg: 'Download SVG', tip: 'Always test the code with your phone camera before printing it. The paper style (dark on light) is the most compatible with older scanners.',
    p: { home: 'My site', lab: 'Lab', chess: 'Challenge me (Lichess)', cv: 'CV', github: 'GitHub' },
  },
}[lang];
const presets = [
  [T.p.home, `${site}/`],
  [T.p.lab, `${site}/${lang}/lab/`],
  [T.p.chess, 'https://lichess.org/?user=DracoKerouac#friend'],
  [T.p.cv, `${site}/cv.pdf`],
  [T.p.github, 'https://github.com/RoshTzsche'],
];
---
<Base lang={lang} title={T.title} defaultMode="terminal" current="qr" altPath={`/${otherLang(lang)}/qr/`}>
  <section class="wrap qr-page">
    <div class="qr-text">
      <p class="kicker">{T.kicker}</p>
      <h1>{T.h1}</h1>
      <p class="sub">{T.sub}</p>

      <label class="field">
        <span class="lbl mono">{T.text}</span>
        <input type="text" value={`${site}/`} data-qr-input spellcheck="false" autocomplete="off" />
      </label>

      <div class="field">
        <span class="lbl mono">{T.presets}</span>
        <div class="chips">
          {presets.map(([label, url]) => <button type="button" class="chip" data-preset={url}>{label}</button>)}
        </div>
      </div>

      <div class="field">
        <span class="lbl mono">{T.style}</span>
        <div class="chips" role="group" aria-label={T.style}>
          <button type="button" class="chip" data-style="terminal" aria-pressed="true">{T.terminal}</button>
          <button type="button" class="chip" data-style="paper" aria-pressed="false">{T.paper}</button>
        </div>
      </div>

      <div class="actions">
        <button type="button" class="btn btn-primary" data-dl="png">{T.download}</button>
        <button type="button" class="btn" data-dl="svg">{T.downloadSvg}</button>
      </div>
      <p class="tip">{T.tip}</p>
    </div>

    <figure class="qr-fig">
      <canvas width="1024" height="1024" data-qr role="img" aria-label="QR"></canvas>
      <figcaption class="mono" data-qr-caption></figcaption>
    </figure>
  </section>
</Base>

<script>
  import QRCode from 'qrcode';

  const PALETTES = {
    terminal: { bg: '#0e0f13', fg: '#e6e6e6', accent: '#b48ead', muted: '#9aa0ad' },
    paper: { bg: '#f4efe4', fg: '#1f1d1a', accent: '#1f3a68', muted: '#5b5346' },
  } as const;
  type Style = keyof typeof PALETTES;

  const canvas = document.querySelector<HTMLCanvasElement>('[data-qr]')!;
  const input = document.querySelector<HTMLInputElement>('[data-qr-input]')!;
  const caption = document.querySelector<HTMLElement>('[data-qr-caption]')!;
  let style: Style = 'terminal';

  // Takens reconstruction of a Lorenz signal, projected on its two principal
  // axes (PCA): the most open "butterfly" view. Normalised so max |x| = 1.
  const makeAttractor = (keep: number) => {
    let x = 1, y = 1, z = 1; const xs: number[] = [];
    for (let i = 0; i < 9000; i++) {
      const dx = 10 * (y - x), dy = x * (28 - z) - y, dz = x * y - (8 / 3) * z;
      x += dx * 0.006; y += dy * 0.006; z += dz * 0.006;
      if (i > 600 && i % 2 === 0) xs.push(x);
    }
    xs.length = Math.min(xs.length, keep);
    const tau = 9, q: number[][] = [];
    for (let i = 2 * tau; i < xs.length; i++) q.push([xs[i], xs[i - tau], xs[i - 2 * tau]]);
    const n = q.length, m = [0, 1, 2].map((k) => q.reduce((s, p) => s + p[k], 0) / n);
    q.forEach((p) => { p[0] -= m[0]; p[1] -= m[1]; p[2] -= m[2]; });
    const C = [0, 1, 2].map((i) => [0, 1, 2].map((j) => q.reduce((s, a) => s + a[i] * a[j], 0) / n));
    const power = (orth: number[][]) => {
      let v = [1, 0.3, 0.2];
      for (let it = 0; it < 200; it++) {
        let w = [0, 1, 2].map((i) => C[i][0] * v[0] + C[i][1] * v[1] + C[i][2] * v[2]);
        for (const o of orth) { const d = w[0] * o[0] + w[1] * o[1] + w[2] * o[2]; w = w.map((t, k) => t - d * o[k]); }
        const nn = Math.hypot(w[0], w[1], w[2]) || 1; v = w.map((t) => t / nn);
      }
      return v;
    };
    const e1 = power([]), e2 = power([e1]);
    const pts = q.map((a) => [a[0] * e1[0] + a[1] * e1[1] + a[2] * e1[2], a[0] * e2[0] + a[1] * e2[1] + a[2] * e2[2]] as [number, number]);
    const r = Math.max(...pts.map((p) => Math.abs(p[0])));
    return pts.map(([X, Y]) => [X / r, Y / r] as [number, number]);
  };
  const attractorBig = makeAttractor(4200);  // faint, behind the modules

  type Shape = { modules: (r: number, c: number) => boolean; n: number };
  function build(text: string): Shape {
    const qr = QRCode.create(text || ' ', { errorCorrectionLevel: 'H' });
    const n = qr.modules.size;
    return { n, modules: (r, c) => Boolean(qr.modules.get(r, c)) };
  }
  const isFinder = (r: number, c: number, n: number) =>
    (r < 7 && c < 7) || (r < 7 && c >= n - 7) || (r >= n - 7 && c < 7);

  // Draws into a Canvas-like target. Also used to emit SVG.
  function render(q: Shape, size: number, draw: {
    rect: (x: number, y: number, w: number, h: number, rad: number, color: string) => void;
    ring: (x: number, y: number, w: number, t: number, rad: number, color: string) => void;
    path: (pts: [number, number][], color: string, width: number, alpha?: number) => void;
    text: (s: string, x: number, y: number, px: number, color: string, align?: 'middle' | 'end') => void;
  }) {
    const P = PALETTES[style];
    const quiet = 4, cell = size / (q.n + quiet * 2), off = quiet * cell;
    draw.rect(0, 0, size, size, size * 0.04, P.bg);
    // faint full-size attractor behind everything (low contrast, so scanners ignore it)
    const mid = size / 2, span = (q.n * cell) / 2;
    draw.path(attractorBig.map(([X, Y]) => [mid + X * span * 0.98, mid - Y * span * 0.98] as [number, number]), P.accent, Math.max(1, cell * 0.07), 0.22);
    for (let r = 0; r < q.n; r++) for (let c = 0; c < q.n; c++) {
      if (!q.modules(r, c) || isFinder(r, c, q.n)) continue;
      const g = cell * 0.12;
      draw.rect(off + c * cell + g, off + r * cell + g, cell - 2 * g, cell - 2 * g, cell * 0.22, P.fg);
    }
    // finder patterns: terminal-style rounded rings with an accent "eye"
    for (const [r, c] of [[0, 0], [0, q.n - 7], [q.n - 7, 0]]) {
      const x = off + c * cell, y = off + r * cell;
      draw.ring(x, y, 7 * cell, cell, cell * 1.6, P.fg);
      draw.rect(x + 2 * cell, y + 2 * cell, 3 * cell, 3 * cell, cell * 0.8, P.accent);
    }
    // signature in the bottom-right quiet zone, outside the code
    draw.text('~ ❯ rosh', size - off * 0.45, size - off * 0.32, cell * 1.1, P.muted, 'end');
  }

  function toCanvas(q: Shape) {
    const ctx = canvas.getContext('2d')!; const S = canvas.width;
    ctx.clearRect(0, 0, S, S);
    const rr = (x: number, y: number, w: number, h: number, rad: number) => {
      ctx.beginPath(); ctx.moveTo(x + rad, y); ctx.arcTo(x + w, y, x + w, y + h, rad); ctx.arcTo(x + w, y + h, x, y + h, rad);
      ctx.arcTo(x, y + h, x, y, rad); ctx.arcTo(x, y, x + w, y, rad); ctx.closePath();
    };
    render(q, S, {
      rect: (x, y, w, h, rad, color) => { rr(x, y, w, h, rad); ctx.fillStyle = color; ctx.fill(); },
      ring: (x, y, w, t, rad, color) => { ctx.lineWidth = t; ctx.strokeStyle = color; rr(x + t / 2, y + t / 2, w - t, w - t, rad); ctx.stroke(); },
      path: (pts, color, width, alpha = 0.9) => { ctx.beginPath(); pts.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y))); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineJoin = 'round'; ctx.globalAlpha = alpha; ctx.stroke(); ctx.globalAlpha = 1; },
      text: (s, x, y, px, color, align = 'middle') => { ctx.fillStyle = color; ctx.font = `${px}px "JetBrains Mono", monospace`; ctx.textAlign = align === 'end' ? 'right' : 'center'; ctx.fillText(s, x, y); },
    });
  }

  function toSvg(q: Shape) {
    const S = 1024, parts: string[] = [];
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    render(q, S, {
      rect: (x, y, w, h, rad, color) => parts.push(`<rect x="${x.toFixed(2)}" y="${y.toFixed(2)}" width="${w.toFixed(2)}" height="${h.toFixed(2)}" rx="${rad.toFixed(2)}" fill="${color}"/>`),
      ring: (x, y, w, t, rad, color) => parts.push(`<rect x="${(x + t / 2).toFixed(2)}" y="${(y + t / 2).toFixed(2)}" width="${(w - t).toFixed(2)}" height="${(w - t).toFixed(2)}" rx="${rad.toFixed(2)}" fill="none" stroke="${color}" stroke-width="${t.toFixed(2)}"/>`),
      path: (pts, color, width, alpha = 0.9) => parts.push(`<path d="${pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('')}" fill="none" stroke="${color}" stroke-width="${width.toFixed(2)}" stroke-opacity="${alpha}" stroke-linejoin="round"/>`),
      text: (s, x, y, px, color, align = 'middle') => parts.push(`<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" font-family="JetBrains Mono, monospace" font-size="${px.toFixed(1)}" text-anchor="${align}" fill="${color}">${esc(s)}</text>`),
    });
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${S} ${S}" width="${S}" height="${S}">${parts.join('')}</svg>`;
  }

  let current: Shape | null = null;
  function update() {
    try {
      current = build(input.value.trim());
      toCanvas(current);
      caption.textContent = `${current.n}×${current.n} · ECC H · ${input.value.trim()}`;
    } catch (e) {
      caption.textContent = String((e as Error).message || e);
    }
  }
  const download = (href: string, name: string) => { const a = document.createElement('a'); a.href = href; a.download = name; a.click(); };

  input.addEventListener('input', update);
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
    b.addEventListener('click', () => { input.value = b.dataset.preset!; update(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-style]').forEach((b) =>
    b.addEventListener('click', () => {
      style = b.dataset.style as Style;
      document.querySelectorAll('[data-style]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      update();
    }));
  document.querySelector('[data-dl="png"]')!.addEventListener('click', () =>
    canvas.toBlob((blob) => blob && download(URL.createObjectURL(blob), `qr-${style}.png`), 'image/png'));
  document.querySelector('[data-dl="svg"]')!.addEventListener('click', () => {
    if (!current) return;
    download(URL.createObjectURL(new Blob([toSvg(current)], { type: 'image/svg+xml' })), `qr-${style}.svg`);
  });
  document.fonts?.ready.then(update);
  update();
</script>

<style>
  .qr-page { padding-block: 64px 24px; display: flex; flex-wrap: wrap; align-items: flex-start; gap: clamp(32px, 5vw, 72px); }
  .qr-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(32px, 4.5vw, 56px); line-height: 1.08; font-weight: 700; }
  :global(:root[data-mode='paper']) h1 { font-weight: 500; }
  .sub { margin: 0; font-size: 18px; line-height: 1.6; color: var(--fg-2); }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .lbl { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  input[type='text'] { min-height: 48px; padding: 0 14px; border-radius: 8px; border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--fg); font-family: var(--font-mono); font-size: 15px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--fg-2); font: inherit; font-size: 14px; cursor: pointer; }
  .chip[aria-pressed='true'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .tip { margin: 0; font-size: 14px; color: var(--muted); }
  .qr-fig { flex: 1 1 360px; max-width: 520px; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .qr-fig canvas { width: 100%; height: auto; aspect-ratio: 1; border-radius: 16px; box-shadow: var(--shadow); }
  .qr-fig figcaption { font-size: 12px; color: var(--muted); word-break: break-all; }
</style>
