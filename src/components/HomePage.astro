---
import Base from '../layouts/Base.astro';
import Attractor from '../components/Attractor.astro';
import EEG from '../components/EEG.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featured, lab, distinctions, competitions } from '../data/projects';
import { useT, otherLang, type Lang } from '../i18n/ui';
import { postsIn, postUrl } from '../lib/posts';
import { tex } from '../lib/tex';
import { person } from '../data/person';
import { talks, kinds } from '../data/talks';

interface Props { lang: Lang; root?: boolean }
const { lang, root = false } = Astro.props;
const t = useT(lang);
const latest = (await postsIn(lang))[0];
const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(`/${lang}/`, Astro.site).href,
  inLanguage: lang,
  dateModified: new Date().toISOString(),
  mainEntity: person,
};
// Award-winning projects first, then the rest of the featured, then the lab
const all = [...featured.filter((p) => p.award), ...featured.filter((p) => !p.award), ...lab];
const years = [...new Set(talks.filter((x) => x.year).map((x) => x.year as number))].sort((a, b) => b - a);
const talkGroups = [
  ...years.map((y) => ({ label: String(y), items: talks.filter((x) => x.year === y) })),
  { label: t.home.talksMore, items: talks.filter((x) => x.year === null) },
].filter((g) => g.items.length);
---
<Base lang={lang} defaultMode="terminal" altPath={`/${otherLang(lang)}/`} canonicalPath={`/${lang}/`} rootRedirect={root} fullTitle={lang === 'es' ? 'Rosh Guadiana Páez — Ingeniería Biomédica · UDLAP' : 'Rosh Guadiana Páez — Biomedical Engineering · UDLAP'}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <!-- HERO: attractor behind the text, compact EEG on the right -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <Attractor bare label="" />
    </div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="mono muted prompt"><span class="accent">~ ❯</span> whoami<span class="cursor accent" aria-hidden="true">▌</span></p>
        <h1>Rosh <span class="nowrap">Guadiana Páez</span></h1>
        <p class="tagline">{t.home.tagline}</p>
        <p class="bio">{t.home.bio}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#projects">{t.home.ctaProjects}</a>
          <a class="btn" href="https://github.com/RoshTzsche">github</a>
          <a class="btn" href="/cv.pdf">cv.pdf</a>
          <a class="btn" href={`/${lang}/chess/`}><img class="btn-ico" src="/pieces/merida/wN.svg" alt="" width="20" height="20" />{t.home.chessBtn}</a>
        </div>
        <p class="fig-note mono"><Fragment set:html={tex(t.home.figCaption)} /> <a href="https://github.com/RoshTzsche/eeg_phase_space">eeg_phase_space</a>. <a class="lab-link" href={`/${lang}/lab/`}>{t.home.labLink}</a></p>
      </div>
      <aside class="hero-eeg">
        <EEG lang={lang} />
      </aside>
    </div>
  </section>

  <!-- DISTINCTIONS -->
  <section class="distinctions" aria-label={t.home.distinctions}>
    <ul class="wrap">
      {distinctions.map((d) => (
        <li><a href={d.href}><span class="mono accent tag">{d.tag}</span><span>{d[lang]}</span></a></li>
      ))}
    </ul>
  </section>

  <!-- PROJECTS: one list, award-winning first, filterable by area -->
  <section id="projects" class="wrap block">
    <span id="biomedical" class="anchor" aria-hidden="true"></span>
    <div class="block-head">
      <h2 class="section-title"><span class="prefix">~/</span>{t.home.projectsTitle}</h2>
      <a class="mono muted" href="https://github.com/RoshTzsche?tab=repositories">{t.home.allRepos}</a>
    </div>
    <div class="filters" role="group" aria-label={t.home.filterLabel}>
      {(['all', 'biomed', 'ai', 'hardware', 'web'] as const).map((k) => (
        <button type="button" data-filter={k} aria-pressed={k === 'all' ? 'true' : 'false'}>
          {t.home.areas[k]} <span class="count mono">{k === 'all' ? all.length : all.filter((p) => p.areas.includes(k)).length}</span>
        </button>
      ))}
    </div>
    <div class="rows" data-rows>
      {all.map((p, i) => <ProjectRow p={p} lang={lang} n={i + 1} />)}
    </div>
  </section>

  <!-- MATH: lectures first, then what I'm studying; quiet styling -->
  <section id="math" class="wrap block">
    <h2 class="section-title"><span class="prefix">~/</span>{t.home.mathTitle}</h2>
    <div class="math-grid">
      <article class="lectures">
        <p class="kicker">{t.home.classesKicker}</p>
        <h3>{t.home.classesTitle}</h3>
        <p class="text">{t.home.classesBody}</p>
        <a class="btn btn-primary lec-btn" href="https://github.com/RoshTzsche/logic_lectures">{t.home.classesCta} →</a>
        <p class="also">{t.home.classesAlso}</p>
      </article>
      <div class="math-side">
        <div>
          <p class="kicker">{t.home.studyingTitle}</p>
          <ul class="pills">
            {t.home.studying.map((s) => <li set:html={tex(s)} />)}
          </ul>
        </div>
        <div>
          <p class="kicker">{t.home.competitions}</p>
          <ul class="comps">
            {competitions.map((c) => (
              <li><span>{typeof c.title === 'string' ? c.title : c.title[lang]}</span><span class="muted">{c[lang]}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Project filters (content stays in the HTML; this only hides rows)
    const rows = [...document.querySelectorAll<HTMLElement>('[data-rows] .row')];
    const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const setFilter = (f: string) => {
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      rows.forEach((r) => { r.hidden = f !== 'all' && !(r.dataset.areas || '').split(' ').includes(f); });
    };
    btns.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.filter!)));
    // the "biomedical" nav link lands here with the filter on
    const fromHash = () => { if (location.hash === '#biomedical') setFilter('biomed'); };
    fromHash(); window.addEventListener('hashchange', fromHash);
  </script>

  <!-- TALKS & OUTREACH: timeline grouped by year -->
  <section id="talks" class="wrap block">
    <div class="block-head col">
      <h2 class="section-title"><span class="prefix">~/</span>{t.home.talksTitle}</h2>
      <p class="muted sub">{t.home.talksSub}</p>
    </div>
    <ol class="timeline">
      {talkGroups.map((g) => (
        <li class="tl-year">
          <span class="tl-label mono">{g.label}</span>
          <ul class="tl-items">
            {g.items.map((x) => (
              <li class="tl-item">
                <span class="tl-kind mono">{kinds[x.kind][lang]}</span>
                <span class="tl-title">{x.href ? <a href={x.href}>{x.title[lang]} <span aria-hidden="true">↗</span></a> : x.title[lang]}</span>
                <span class="tl-where">{x.where[lang]}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- RESEARCH + WRITING TEASER -->
  <section id="research" class="wrap block split">
    <div class="card grow">
      <h2 class="section-title"><span class="prefix">~/</span>{t.home.researchTitle}</h2>
      <p class="role">{t.home.researchRole}</p>
      <p class="text">{t.home.researchBody}</p>
      <p class="mono muted small"><a href="https://orcid.org/0009-0007-0324-3939">ORCID 0009-0007-0324-3939</a></p>
    </div>
    <a class="paper-teaser side" href={latest ? postUrl(latest) : `/${lang}/writing/`}>
      <span class="mono small">{t.home.latestWriting}</span>
      <span class="teaser-title" set:html={tex(latest ? latest.data.title : t.home.noPostsYet)} />
      <span class="small">{t.home.readInPaper}</span>
    </a>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: calc(100svh - var(--nav-h, 72px)); display: flex; align-items: center; }
  .hero-bg {
    position: absolute; inset: 0;
    opacity: 0.55; pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 55% 75% at 64% 50%, #000 40%, transparent 100%);
            mask-image: radial-gradient(ellipse 55% 75% at 64% 50%, #000 40%, transparent 100%);
  }
  :global(:root[data-mode='paper']) .hero-bg { opacity: 0.32; }
  .hero-grid { position: relative; z-index: 1; width: 100%; padding-block: clamp(48px, 8vh, 120px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: clamp(32px, 5vw, 80px); }
  .hero-text { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: clamp(16px, 2.4vh, 28px); }
  .hero-eeg { flex: 1 1 300px; max-width: clamp(300px, 26vw, 420px); min-width: 0; }
  @media (max-width: 900px) {
    .hero { align-items: flex-start; }
    .hero-eeg { max-width: none; }
    .hero-bg {
      opacity: 0.3;
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 42%, #000 35%, transparent 100%);
              mask-image: radial-gradient(ellipse 80% 55% at 50% 42%, #000 35%, transparent 100%);
    }
  }
  @media (max-width: 560px) {
    .ctas .btn { flex: 1 1 auto; justify-content: center; }
    .fig-note { display: none; }
  }
  .prompt { margin: 0; font-size: 15px; }
  .cursor { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(34px, 4.6vw, 92px); line-height: 1.02; font-weight: 700; letter-spacing: -0.02em; text-shadow: 0 2px 24px var(--bg); }
  :global(:root[data-mode='paper']) h1 { font-weight: 500; letter-spacing: 0; font-size: clamp(42px, 6.2vw, 112px); }
  .nowrap { white-space: nowrap; }
  @media (min-width: 901px) { h1 { white-space: nowrap; } }
  :global(:root[data-mode='paper']) .prompt { display: none; }
  .tagline { margin: 0; font-family: var(--font-mono); font-size: clamp(14px, 0.5vw + 11px, 19px); color: var(--accent); }
  .bio { margin: 0; max-width: 46ch; font-size: clamp(16px, 0.45vw + 13px, 21px); line-height: 1.65; color: var(--fg-2); text-shadow: 0 1px 12px var(--bg); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }
  .ctas .btn:not(.btn-primary) { background: color-mix(in srgb, var(--bg) 70%, transparent); }
  .fig-note { margin: 0; font-size: 12px; line-height: 1.6; color: var(--muted); max-width: 560px; }
  .fig-note a { color: var(--fg-2); text-decoration: underline; }

  .distinctions { border-block: 1px solid var(--line); background: var(--surface-2); }
  .distinctions ul { list-style: none; margin: 0 auto; padding-block: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 20px; }
  .distinctions li a { display: flex; flex-direction: column; gap: 4px; font-size: 15px; padding: 4px 0; }
  .distinctions li a:hover span:last-child { text-decoration: underline; }
  .tag { font-size: 12px; }

  .block { padding-block: 72px 8px; display: flex; flex-direction: column; gap: 28px; }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
  .block-head.col { flex-direction: column; align-items: flex-start; gap: 8px; }
  .block-head a { font-size: 14px; }
  .sub { margin: 0; font-size: 16px; }
  .split { flex-direction: row; flex-wrap: wrap; gap: 20px; }
  .grow { flex: 999 1 520px; min-width: 0; padding: clamp(20px, 3vw, 28px); }
  .side { flex: 1 1 300px; min-width: 0; }
  .small { margin: 0; font-size: 13px; }
  .text { margin: 0; font-size: 16px; line-height: 1.6; color: var(--fg-2); }
  .role { margin: 0; font-size: 17px; font-weight: 600; }
  .card.side { padding: 28px; }

  .paper-teaser { padding: 28px; border-radius: 10px; background: #f4efe4; color: #1f1d1a; border: 1px solid #d9d0bf; display: flex; flex-direction: column; gap: 12px; }
  .paper-teaser .mono { color: #5b5346; }
  .paper-teaser .small { color: #5b5346; font-family: Newsreader, Georgia, serif; font-size: 16px; }
  .teaser-title { font-family: Newsreader, Georgia, serif; font-size: 26px; line-height: 1.25; }
  :global(:root[data-mode='paper']) .paper-teaser { background: var(--surface-2); }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  .btn-ico { width: 20px; height: 20px; }
  .anchor { position: relative; top: -96px; }
  .rows { display: flex; flex-direction: column; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; color: var(--fg-2); font: inherit; font-size: 14px; cursor: pointer; }
  .filters button:hover { border-color: var(--fg-2); }
  .filters button[aria-pressed='true'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .count { font-size: 11px; opacity: 0.7; }

  .math-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  @media (max-width: 860px) { .math-grid { grid-template-columns: 1fr; } }
  .lectures { display: flex; flex-direction: column; gap: 16px; padding: clamp(24px, 3vw, 40px); border: 1px solid var(--line-strong); border-radius: 14px; background: var(--surface); }
  .lectures h3 { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 3vw, 42px); line-height: 1.1; font-weight: 700; }
  :global(:root[data-mode='paper']) .lectures h3 { font-weight: 500; }
  .lectures .text { font-size: clamp(16px, 0.35vw + 13px, 18px); line-height: 1.65; }
  .lec-btn { align-self: flex-start; }
  .also { margin: 0; font-size: 14px; color: var(--muted); }
  .math-side { display: flex; flex-direction: column; gap: 32px; padding-top: 8px; }
  .math-side .kicker { margin-bottom: 14px; }
  .pills { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { display: inline-flex; align-items: center; justify-content: center; text-align: center; min-height: 40px; padding: 6px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: 15px; color: var(--fg-2); }
  .comps { margin: 0; padding: 0; list-style: none; }
  .comps li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .comps li:last-child { border-bottom: 1px solid var(--line); }
  .lab-link { color: var(--accent) !important; text-decoration: none !important; white-space: nowrap; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .tl-year { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 24px; padding: 22px 0; border-top: 1px solid var(--line); }
  .tl-year:last-child { border-bottom: 1px solid var(--line); }
  .tl-label { font-size: 22px; font-weight: 700; color: var(--fg); }
  :global(:root[data-mode='paper']) .tl-label { font-family: var(--font-display); font-weight: 500; font-size: 26px; }
  .tl-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .tl-item { display: grid; grid-template-columns: 110px minmax(0, 1.4fr) minmax(0, 1fr); gap: 4px 20px; align-items: baseline; }
  .tl-kind { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .tl-title { font-size: 17px; color: var(--fg); }
  .tl-title a:hover { color: var(--accent); }
  .tl-where { font-size: 15px; color: var(--muted); }
  @media (max-width: 760px) {
    .tl-year { grid-template-columns: 1fr; gap: 12px; }
    .tl-item { grid-template-columns: 1fr; }
  }
</style>
