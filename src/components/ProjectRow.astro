---
// Editorial project row: number · title block · full description.
// Monochrome; the accent only marks awards and hover.
import fs from 'node:fs';
import { repoUrl, type Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
interface Props { p: Project; lang: Lang; n: number; compact?: boolean }
const { p, lang, n, compact = false } = Astro.props;
const image = ['webp', 'jpg', 'jpeg', 'png', 'gif']
  .map((ext) => `/projects/${p.repo}.${ext}`)
  .find((src) => fs.existsSync(`public${src}`));
const tags = p.stack.split('·').map((s) => s.trim());
---
<article id={`p-${p.repo}`} class:list={['row', { compact, 'has-image': !!image }]}>
  <span class="idx mono" aria-hidden="true">{String(n).padStart(2, '0')}</span>

  <div class="head">
    {p.award && <p class="award mono"><span class="star" aria-hidden="true">★</span> {p.award[lang].replace(/^★\s*/, '')}</p>}
    <h3>
      <a href={repoUrl(p.repo)}>
        {p.title[lang]}<span class="arrow" aria-hidden="true">↗</span>
      </a>
    </h3>
    <p class="repo mono">github / {p.repo}</p>
  </div>

  <div class="desc">
    <p>{p.body[lang]}</p>
    <ul class="tags mono" aria-label="Stack">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
    {(p.foot || p.links) && (
      <p class="foot mono">
        {p.foot && <span>{p.foot[lang]}</span>}
        {p.links?.map((l) => <a href={l.href}>{l.label[lang]} ↗</a>)}
      </p>
    )}
  </div>

  {image && (
    <a class="thumb" href={repoUrl(p.repo)} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" loading="lazy" decoding="async" />
    </a>
  )}
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 12px clamp(24px, 4vw, 64px);
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 96px;
  }
  .row.has-image { grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 0.7fr); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .row:target { background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%); }

  .idx { font-size: 14px; color: var(--muted); padding-top: 0.5em; transition: color 0.2s ease; }
  .head { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .award { margin: 0; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg); }
  .star { color: var(--accent); }
  h3 { margin: 0; font-family: var(--font-display); font-size: clamp(26px, 2.6vw, 38px); line-height: 1.1; font-weight: 700; letter-spacing: -0.01em; }
  :global(:root[data-mode='paper']) h3 { font-weight: 500; letter-spacing: 0; }
  h3 a::after { content: ''; position: absolute; inset: 0; } /* whole row clickable */
  .arrow { display: inline-block; margin-left: 0.25em; font-size: 0.6em; vertical-align: 0.35em; color: var(--muted); transition: transform 0.2s ease, color 0.2s ease; }
  .repo { margin: 0; font-size: 12px; color: var(--muted); }

  .desc { display: flex; flex-direction: column; gap: 16px; min-width: 0; padding-top: 0.3em; }
  .desc > p:first-child { margin: 0; font-size: clamp(16px, 0.35vw + 13px, 18px); line-height: 1.65; color: var(--fg-2); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .tags li { padding: 3px 10px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 12px; color: var(--muted); }
  .foot { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12px; color: var(--muted); position: relative; z-index: 1; }
  .foot a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }

  .thumb { position: relative; z-index: 1; display: block; align-self: start; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; filter: grayscale(1); transition: filter 0.3s ease; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }

  .row:hover .idx, .row:hover h3 a { color: var(--accent); }
  .row:hover .arrow { color: var(--accent); transform: translate(3px, -3px); }
  .row:hover .thumb { filter: none; }

  /* compact variant (biomedical lab): two per line */
  .row.compact { grid-template-columns: 40px minmax(0, 1fr); padding: 28px 0; }
  .row.compact .desc { grid-column: 2; padding-top: 0; }
  .row.compact h3 { font-size: clamp(22px, 1.8vw, 28px); }

  @media (max-width: 860px) {
    .row, .row.has-image { grid-template-columns: 36px minmax(0, 1fr); }
    .desc, .thumb { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .arrow, .thumb { transition: none; } }
</style>
