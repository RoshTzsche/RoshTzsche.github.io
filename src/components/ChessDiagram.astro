---
// Static board from a FEN position. flip = view from Black's side.
interface Props { fen: string; flip?: boolean; label: string; size?: string }
const { fen, flip = false, label, size = '260px' } = Astro.props;
// Merida pieces (Lichess): /public/pieces/merida/{w|b}{K,Q,R,B,N,P}.svg
const piece = (c: string) => (c === c.toUpperCase() ? 'w' : 'b') + c.toUpperCase();
let rows: string[][] = fen.split(' ')[0].split('/').map((r) =>
  r.split('').flatMap((c) => (/\d/.test(c) ? Array(Number(c)).fill('') : [piece(c)]))
);
if (flip) rows = rows.reverse().map((r) => r.reverse());
const squares = rows.flatMap((row, r) => row.map((piece, f) => ({ piece, light: (r + f) % 2 === 0 })));
---
<div class="board" role="img" aria-label={label} style={`max-width: ${size}`}>
  {squares.map((s) => <div class:list={['sq', s.light ? 'light' : 'dark']}>{s.piece && <img src={`/pieces/merida/${s.piece}.svg`} alt="" loading="lazy" />}</div>)}
</div>

<style>
  .board { width: 100%; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); border: 2px solid #3d372e; }
  .sq { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; }
  .sq img { width: 100%; height: 100%; }
  .light { background: #efe6d2; }
  .dark { background: #b9a27e; }
</style>
