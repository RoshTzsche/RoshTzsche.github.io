---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<button type="button" class="floating-mode" data-mode-toggle>
  <span class="term-only">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"></path><path d="M14 3v5h5"></path><path d="M9 13h7M9 17h5"></path></svg>
    {t.mode.floatToPaper}
  </span>
  <span class="paper-only">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-5-6-5"></path><path d="M12 19h8"></path></svg>
    {t.mode.floatToTerminal}
  </span>
  <kbd>D</kbd>
</button>

<style>
  .floating-mode {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 18px 0 16px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .floating-mode span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  /* In terminal mode the button previews paper, and vice versa */
  :global(:root[data-mode='terminal']) .floating-mode {
    background: #f4efe4;
    color: #1f1d1a;
    font-family: Newsreader, Georgia, serif;
    font-size: 17px;
    font-style: italic;
  }
  :global(:root[data-mode='paper']) .floating-mode {
    background: #0e0f13;
    color: #e6e6e6;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
  }
  .floating-mode kbd {
    font-style: normal;
  }
  /* phones: a round icon button that doesn't cover the content */
  @media (max-width: 640px) {
    .floating-mode { right: 14px; bottom: calc(14px + env(safe-area-inset-bottom)); width: 52px; padding: 0; justify-content: center; }
    .floating-mode kbd { display: none; }
    .floating-mode span { font-size: 0; gap: 0; }
    .floating-mode span svg { width: 22px; height: 22px; }
  }
</style>
