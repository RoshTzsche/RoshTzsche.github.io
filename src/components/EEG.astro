---
// Compact synthetic 6-channel EEG (eyes closed): alpha 10 Hz strongest over O1/O2,
// beta 21 Hz, theta 5.5 Hz, AR(1) noise, and eye blinks on Fp1/Fp2.
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<div class="eeg">
  <div class="eeg-head mono">
    <span><span class="accent">❯</span> eeg --fs 256</span>
    <span class="live"><span class="dot" aria-hidden="true"></span>{t.home.eegCaption}</span>
  </div>
  <div class="eeg-body">
    <div class="labels mono" aria-hidden="true"><span>Fp1</span><span>Fp2</span><span>C3</span><span>C4</span><span>O1</span><span>O2</span></div>
    <canvas class="eeg-canvas" role="img" aria-label={Astro.props.lang === 'es' ? 'Seis canales de EEG sintético animados' : 'Six animated synthetic EEG channels'}></canvas>
  </div>
  <p class="eeg-note">{t.home.eegNote} <a href="https://github.com/RoshTzsche/eeg_phase_space">eeg_phase_space</a>.</p>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.eeg-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // AR(1) noise per channel: n_k = 0.6 n_{k-1} + ε_k
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647 - 0.5;
    const N = 4096;
    const noise = Array.from({ length: 6 }, () => {
      const a = new Float32Array(N); let prev = 0;
      for (let i = 0; i < N; i++) { prev = 0.6 * prev + rnd(); a[i] = prev; }
      return a;
    });
    // [alpha, beta, theta, blink]
    const cfg = [[0.25, 0.35, 0.3, 1], [0.25, 0.35, 0.3, 1], [0.5, 0.3, 0.25, 0], [0.5, 0.3, 0.25, 0], [1.0, 0.15, 0.2, 0], [0.95, 0.15, 0.2, 0]];
    let t = 0, visible = true;
    let colors = { fg: '', accent: '', line: '' };
    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      colors = { fg: cs.getPropertyValue('--muted').trim(), accent: cs.getPropertyValue('--accent').trim(), line: cs.getPropertyValue('--line').trim() };
    };
    readColors();
    window.addEventListener('modechange', () => { readColors(); draw(); });

    const resize = () => {
      const dpr = window.devicePixelRatio || 1, r = canvas.getBoundingClientRect();
      canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr); draw();
    };

    function sample(ch: number, k: number) {
      const c = cfg[ch], ts = (k / 256) * 1.6;
      let v = c[0] * Math.sin(2 * Math.PI * 10 * ts + ch) * (0.7 + 0.3 * Math.sin(2 * Math.PI * 0.4 * ts + ch))
            + c[1] * Math.sin(2 * Math.PI * 21 * ts + 2 * ch)
            + c[2] * Math.sin(2 * Math.PI * 5.5 * ts + 0.5 * ch)
            + 0.35 * noise[ch][k % N];
      if (c[3]) { const ph = (k % 700) - 60; v += 3.2 * Math.exp(-(ph * ph) / 260); }
      return v;
    }

    function draw() {
      const W = canvas.width, H = canvas.height, row = H / 6, n = 220, dpr = window.devicePixelRatio || 1;
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = colors.line; ctx.lineWidth = dpr;
      for (let r = 1; r < 6; r++) { ctx.beginPath(); ctx.moveTo(0, r * row); ctx.lineTo(W, r * row); ctx.stroke(); }
      ctx.lineWidth = 1.1 * dpr;
      for (let ch = 0; ch < 6; ch++) {
        ctx.beginPath();
        for (let i = 0; i < n; i++) {
          const v = Math.max(-2, Math.min(2, sample(ch, t + i)));
          const x = (i / (n - 1)) * W, y = row * (ch + 0.5) - v * row * 0.22;
          if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y);
        }
        ctx.strokeStyle = ch >= 4 ? colors.accent : colors.fg;
        ctx.stroke();
      }
    }

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);
    if (!reduce) {
      let last = 0;
      const loop = (ts: number) => {
        if (visible && !document.hidden && ts - last > 33) { t += 3; draw(); last = ts; }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .eeg { display: flex; flex-direction: column; gap: 10px; opacity: 0.9; }
  .eeg-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--muted); }
  .live { display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--accent); animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }
  .eeg-body { display: flex; gap: 10px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: color-mix(in srgb, var(--surface-2) 70%, transparent); backdrop-filter: blur(4px); }
  .labels { width: 28px; display: flex; flex-direction: column; justify-content: space-around; font-size: 11px; color: var(--muted); }
  .eeg-canvas { flex: 1; min-width: 0; height: 240px; }
  .eeg-note { margin: 0; font-size: 12px; line-height: 1.5; color: var(--muted); }
  .eeg-note a { color: var(--accent); }
  @media (max-width: 560px) { .eeg-canvas { height: 170px; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
</style>
