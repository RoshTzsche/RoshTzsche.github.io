---
import ModeSwitch from './ModeSwitch.astro';
import { useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang; current: string; altPath: string }
const { lang, current, altPath } = Astro.props;
const t = useT(lang);
const links = [
  { key: 'projects', href: `/${lang}/#projects`, label: t.nav.projects },
  { key: 'biomedical', href: `/${lang}/#biomedical`, label: t.nav.biomedical },
  { key: 'math', href: `/${lang}/#math`, label: t.nav.math },
  { key: 'talks', href: `/${lang}/#talks`, label: t.nav.talks },
  { key: 'lab', href: `/${lang}/lab/`, label: t.nav.lab },
  { key: 'writing', href: `/${lang}/writing/`, label: t.nav.writing },
  { key: 'chess', href: `/${lang}/chess/`, label: t.nav.chess },
  { key: 'cv', href: '/cv.pdf', label: t.nav.cv },
];
---
<header class="nav">
  <nav class="wrap nav-inner" aria-label="Main">
    <a class="brand" href={`/${lang}/`}>
      <span class="term-only"><span class="accent">rosh</span>@guadiana<span class="muted">:~$</span></span>
      <span class="paper-only">Rosh Guadiana Páez</span>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-links" aria-label={lang === 'es' ? 'Menú' : 'Menu'}>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="l1" d="M4 7h16"></path><path class="l2" d="M4 12h16"></path><path class="l3" d="M4 17h16"></path></svg>
    </button>
    <div class="nav-links" id="nav-links">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined} class:list={['nav-link', { active: current === l.key }]}>
          <span class="term-only">./</span>{l.label}
        </a>
      ))}
    </div>
    <div class="nav-controls">
      <ModeSwitch lang={lang} />
      <div class="lang" role="group" aria-label={t.langSwitch}>
        <a href={lang === 'es' ? undefined : altPath} data-lang-link="es" aria-current={lang === 'es' ? 'true' : undefined} lang="es">ES</a>
        <span aria-hidden="true">|</span>
        <a href={lang === 'en' ? undefined : altPath} data-lang-link="en" aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.nav');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const links = document.getElementById('nav-links');
  // expose the nav height so full-screen sections can subtract it
  const setH = () => header && document.documentElement.style.setProperty('--nav-h', header.offsetHeight + 'px');
  setH(); new ResizeObserver(setH).observe(header!);
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    links?.classList.toggle('open', open);
  });
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    btn?.setAttribute('aria-expanded', 'false'); links.classList.remove('open');
  }));
</script>

<style is:global>
  :root[data-mode='terminal'] .paper-only { display: none; }
  :root[data-mode='paper'] .term-only { display: none; }
</style>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 28px;
    padding-block: 14px;
  }
  .brand {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }
  :root[data-mode='paper'] .brand {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  :root[data-mode='paper'] .nav-links {
    font-family: var(--font-display);
    font-size: 17px;
    text-transform: capitalize;
  }
  .nav-link {
    color: var(--fg-2);
    padding-block: 6px;
  }
  .nav-link.active {
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
  }
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 4px;
    color: var(--muted);
  }
  .lang a[aria-current] {
    color: var(--fg);
    font-weight: 700;
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-btn path { transition: transform 0.2s ease, opacity 0.2s ease; transform-origin: 12px 12px; }
  .menu-btn[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .l2 { opacity: 0; }
  .menu-btn[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }

  /* ---------- phones & small tablets ---------- */
  @media (max-width: 960px) {
    .nav-inner { gap: 10px; }
    .brand { order: 1; flex: 1; }
    .menu-btn { display: inline-flex; order: 3; }
    .nav-controls { order: 2; gap: 8px; }
    .nav-links {
      order: 4;
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding: 6px 0 10px;
      font-size: 17px;
    }
    .nav-links.open { display: flex; }
    .nav-link { padding: 12px 4px; border-top: 1px solid var(--line); }
    .nav-link.active { border-bottom: 0; }
  }
  @media (max-width: 420px) {
    .brand { font-size: 13px; }
    :root[data-mode='paper'] .brand { font-size: 17px; }
    .lang span { display: none; }
  }
</style>
